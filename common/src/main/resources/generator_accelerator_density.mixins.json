{
  "required": true,
  "package": "dev.sixik.generator_accelerator.common.density.mixin",
  "compatibilityLevel": "JAVA_21",
  "minVersion": "0.8",
  "plugin": "dev.sixik.generator_accelerator.common.density.GADensityMixinPlugin",
